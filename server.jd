const express = require("express");
const cors = require("cors");
const OpenAI = require("openai");

const app = express();

app.use(cors({
  origin: "https://totalgaming5491-cell.github.io"
}));

app.use(express.json({ limit: "1mb" }));

const client = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
});

app.get("/", (req, res) => {
  res.send("Lipsa AI server is running 🌸");
});

app.post("/api/chat", async (req, res) => {
  try {
    const prompt = req.body.prompt;

    if (!prompt || typeof prompt !== "string") {
      return res.status(400).json({ error: "Message is missing." });
    }

    const response = await client.responses.create({
      model: "gpt-4o-mini",
      input: prompt
    });

    res.json({ text: response.output_text });

  } catch (error) {
    console.error("Lipsa AI error:", error.message);
    res.status(500).json({
      error: "Lipsa couldn't reply. Please try again."
    });
  }
});

const PORT = process.env.PORT || 3000;

app.listen(PORT, () => {
  console.log(`Lipsa AI running on port ${PORT}`);
});
